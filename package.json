{
  "name": "@brass-build/cli",
  "version": "0.3.0",
  "description": "Brass command-line tool: publish apps and pull schemas from a terminal or CI",
  "type": "module",
  "bin": {
    "brass": "./dist/bin/brass.js"
  },
  "files": [
    "dist",
    "src",
    "!src/**/__tests__/**",
    "README.md",
    "AGENTS.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b",
    "type-check": "tsc -b",
    "prepublishOnly": "tsc -b --force"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "typescript": "~6.0.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brass-build/cli.git"
  },
  "homepage": "https://brass.build",
  "license": "MIT"
}
